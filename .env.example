# ─── Copy to .env and fill in. Never commit .env. ───────────────────────────

ASTRA_ENV=development
ASTRA_LOG_LEVEL=INFO

# ─── Auth ────────────────────────────────────────────────────────────────────
# The tunnel is public. This token is the only thing between the internet and
# your data. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ASTRA_DEVICE_TOKEN=change-me-before-exposing-anything

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra-local-dev
POSTGRES_DB=astra
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Models ──────────────────────────────────────────────────────────────────
# Logical names are resolved by the model registry (app/llm/registry.py).
ASTRA_MODEL_PROFILE=cloud_first          # cloud_first | local_only
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Sonnet 5, not Opus. This is a personal-assistant workload — logging, recall,
# coaching, planning — not heavy code reasoning, which is what the Opus premium
# buys. Sonnet 5 handles all six agents comfortably at roughly 60% of the cost.
ASTRA_MODEL_REASONING=anthropic/claude-sonnet-5

# Haiku for the high-volume, low-nuance paths: fact extraction, session
# summaries, weekly rollups. These run on a schedule and never face the user.
ASTRA_MODEL_CHEAP=anthropic/claude-haiku-4-5
# Sized for 6 GB VRAM (RTX 4050 Laptop), sharing the card with Whisper.
#
#   14B Q4  ~9.0 GB  will not load
#    8B Q4  ~5.0 GB  loads, but +1 GB Whisper leaves nothing for KV cache and
#                    context — spills to CPU and crawls
#    3B Q4  ~1.9 GB  fits with real headroom
#
# 3B is adequate for exercising the plumbing (does the tool fire, does the row
# get written, does recall work). It is NOT adequate for judging personality
# adherence or Athena-grade reasoning — use a cloud model to evaluate those.
ASTRA_MODEL_LOCAL=ollama/qwen2.5:3b-instruct

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Dimension is baked into the migration. Changing it requires a new migration.
ASTRA_EMBED_MODEL=ollama/nomic-embed-text
ASTRA_EMBED_DIM=768

# ─── Voice (Phase 2) ─────────────────────────────────────────────────────────
ASTRA_WHISPER_MODEL=large-v3-turbo
ASTRA_WHISPER_DEVICE=cuda
# int8 (~1 GB) rather than float16 (~1.6 GB): on a 6 GB card Whisper has to
# coexist with a local LLM. Switch to float16 when running cloud-first, where
# the card is Whisper's alone.
ASTRA_WHISPER_COMPUTE=int8
ASTRA_PIPER_VOICES_DIR=/models/piper

# ─── Behaviour ───────────────────────────────────────────────────────────────
ASTRA_SESSION_TIMEOUT_SECONDS=90
ASTRA_ROUTE_CONFIDENCE_FLOOR=0.70
ASTRA_ROUTE_AMBIGUITY_MARGIN=0.05
ASTRA_TIMEZONE=Asia/Kolkata
ASTRA_CURRENCY=INR

# ─── Cost ceiling ────────────────────────────────────────────────────────────
# Hard monthly cloud spend ceiling, in paise. 200000 = 2,000 rupees.
#
# For reference, measured against this system's actual token budgets:
#   ~20 turns/day  ->  ~130 (Haiku) / ~390 (Sonnet 5) / ~650 (Opus 5) rupees
#   ~50 turns/day  ->  ~330 / ~975 / ~1630 rupees
# So 2,000 is comfortable headroom, not a tight cap.
ASTRA_MONTHLY_COST_CEILING_MINOR=200000

# What happens when the ceiling is reached.
#   fallback  agents keep working on the local model (recommended)
#   block     cloud calls raise BudgetExceeded — hard stop, agents go down
# The ceiling is checked before each cloud call, so it can be exceeded by at
# most one call's cost: it bounds new spend rather than stopping exactly.
ASTRA_COST_CEILING_ACTION=fallback

# Paise per USD, for converting vendor list prices into the INR ledger.
ASTRA_USD_INR_PAISE=8800
